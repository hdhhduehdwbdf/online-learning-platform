  "entities": [
    {
      "name": "LearningUser",
      "store": "localStorage.learningUser",
      "fields": [
        "name",
        "role",
        "goal"
      ],
      "notes": "登录时写入；退出登录清除"
    },
    {
      "name": "LearningProfileAnswers",
      "store": "localStorage.learningProfileAnswers",
      "fields": [
        "5 维度 × 4 题的 1-5 分"
      ],
      "notes": "画像与学伴匹配的输入"
    },
    {
      "name": "MatchedAgent",
      "store": "localStorage.matchedAgent",
      "fields": [
        "concept|task|scenario|discussion"
      ],
      "notes": "画像确认后写入，驱动首页/个人中心/学伴页"
    },
    {
      "name": "Telemetry",
      "store": "localStorage.learningTelemetry",
      "fields": [
        "资源打开、提问次数、讨论行为、协调器路由记录（按章分桶）"
      ],
      "notes": "反馈更新页的数据来源"
    },
    {
      "name": "UploadedCourse",
      "store": "localStorage.courseList + IndexedDB zbxk-courses",
      "fields": [
        "id",
        "title",
        "status(processing|ready)",
        "chapters[id,title,summary,pageStart,pageEnd]"
      ],
      "notes": "结构在 localStorage；PDF 原文与章节全文在 IndexedDB"
    },
    {
      "name": "SectionMessages",
      "store": "localStorage.sectionMessages",
      "fields": [
        "每章最近 20 条对话"
      ],
      "notes": "含协调器决策标注"
    },
    {
      "name": "CoordinatorDecisions",
      "store": "localStorage.coordinatorDecisions",
      "fields": [
        "selectedAgent",
        "secondaryAgent",
        "reason",
        "strategy"
      ],
      "notes": "每轮问答前写入，徽章展示"
    },
    {
      "name": "SupportAdjustmentStatus",
      "store": "localStorage.supportAdjustmentStatus",
      "fields": [
        "confirmed|deferred",
        "周期时间戳"
      ],
      "notes": "周报弹窗确认/暂缓写入"
    }
  ],
  "dataFlows": [
    {
      "id": "DF-01",
      "name": "章节问答",
      "path": "用户提问 → /api/section-chat → 注入当前章资源摘录（上传课程为该章全文 28000 字符上限）→ DeepSeek → Markdown 渲染回显",
      "screens": [
        "SEC-01",
        "SEC-05",
        "SEC-06",
        "SEC-10"
      ]
    },
    {
      "id": "DF-02",
      "name": "协调器路由",
      "path": "用户提问 → /api/coordinator-chat → 画像+章节+任务+行为数据 → 结构化 JSON 路由决策 → 主学伴人设生成回答 → 展示理由；解析失败回退关键词规则",
      "screens": [
        "AGT-01",
        "AGT-02"
      ]
    },
    {
      "id": "DF-03",
      "name": "课程上传拆章",
      "path": "PDF 文件 → pdf.js 浏览器端逐页抽取 → 章节标题正则切分 → （可选）LLM 校准标题与摘要 → IndexedDB 持久化 → courseList 更新 → 自动切换",
      "screens": [
        "UPL-01",
        "UPL-02",
        "UPL-04",
        "UPL-03"
      ]
    },
    {
      "id": "DF-04",
      "name": "画像识别闭环",
      "path": "20 题量表 → 五维分值 → 主学伴匹配规则 → 画像确认 → 首页/个人中心/工具页联动 → 遥测持续写入 → 周报（优势/困难/画像变化）→ 学习者确认支持调整",
      "screens": [
        "DIA-10",
        "DIA-20",
        "HOM-01",
        "PRF-01",
        "FDB-01",
        "FDB-02"
      ]
    }
  ],
  "coverage": {
    "included": [
      "登录弹窗",
      "诊断测试：介绍/自动触发、5 个维度逐题作答、结果确认（7 屏）",
      "课程首页两态（空画像/已匹配）",
      "个人中心两态（空画像/有画像+雷达）",
      "章节工作台：资源阅读/第2资源/讨论区/发帖成功/提问发送中/AI回答/上传课程章节文本（7 屏）",
      "学伴匹配页与协调器决策卡（2 屏）",
      "任务表现：任务页/提醒弹窗/手动重开（3 屏）",
      "反馈更新页与周报弹窗（2 屏）",
      "上传流程四态（弹窗/抽取/AI校准/完成切课）",
      "课程切换（切回默认）"
    ],
    "merged": [
      "DIA-01/DIA-02 为同一弹窗的两种触发方式，分列保留",
      "TSK-02/TSK-03 为同一弹窗的自动/手动触发，分列保留"
    ],
    "excluded": [
      "移动端布局（产品当前为桌面单栏自适应）",
      "登录弹窗的身份下拉展开态（原生 select，无自定义样式）"
    ],
    "unverified": [
      "网络失败时 AI 对话的报错恢复路径",
      "同时上传多个课程时的切换顺序",
      "重新识别差异后旧画像数据的清理"
    ]
  },
  "limitations": [
    "页面图为 2x 截图（PNG 栅格，2880×2000），不可编辑图层；语义模型与标注以 ue-spec 为准",
    "示例数据（同学A/B帖子、演示任务）为原型内置演示内容",
    "AI 回复依赖 .env.local 中的 API 配置；无 Key 时规则拆分仍可用，AI 问答返回配置提示",
    "周报入口位于个人中心弹窗内（非反馈更新页直接按钮）"
  ]
